{
	"name": "wiant-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"lint": "biome lint .",
		"format": "biome check --write --unsafe .",
