		"@testing-library/react": "^16.3.2",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"jsdom": "^28",
		"openapi-typescript": "^7.13.0",
		"typescript": "^6",
		"vite": "^8",
		"vitest": "^4"
